# AgentForge configuration. Copy to .env and source it, or export these variables.
# Every value below has a safe local default except the optional provider keys.

# --- Runtime -----------------------------------------------------------------
AGENTFORGE_ENV=development
AGENTFORGE_LOG_LEVEL=INFO
AGENTFORGE_DB_PATH=var/agentforge.db
AGENTFORGE_DATA_DIR=data
AGENTFORGE_SEED_ON_STARTUP=true
AGENTFORGE_HOST=0.0.0.0
AGENTFORGE_PORT=8000

# --- API keys ----------------------------------------------------------------
# Format: key:tenant:role,key:tenant:role
# Roles: viewer (read-only), analyst (run agents), admin (ingest, audit, approve)
# CHANGE THESE BEFORE DEPLOYING.
AGENTFORGE_API_KEYS=demo-analyst-key:demo:analyst,demo-admin-key:demo:admin,research-analyst-key:research:analyst,viewer-key:demo:viewer

# --- Guardrails & FinOps -----------------------------------------------------
AGENTFORGE_AUTH_ENABLED=true
AGENTFORGE_RATE_LIMIT_PER_MINUTE=120
AGENTFORGE_RATE_LIMIT_BURST=30
AGENTFORGE_DAILY_BUDGET_USD=25.0
AGENTFORGE_CACHE_TTL_SECONDS=300
AGENTFORGE_CACHE_MAX_ENTRIES=512
AGENTFORGE_INJECTION_THRESHOLD=0.7
AGENTFORGE_RETRIEVAL_TOP_K=4
AGENTFORGE_REDACT_OUTPUT=true
AGENTFORGE_REQUEST_TIMEOUT_SECONDS=30
AGENTFORGE_MAX_INPUT_CHARS=8000
AGENTFORGE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Optional model providers ------------------------------------------------
# The platform runs fully offline with the deterministic grounded provider.
# Add one or more keys to enable frontier-model routing. No code changes needed.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
